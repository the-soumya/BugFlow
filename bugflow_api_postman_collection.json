		{
			"name": "Step 2: Login and obtain JWT",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.success && jsonData.data && jsonData.data.token) {",
							"    pm.globals.set(\"bugflow_jwt_token\", jsonData.data.token);",
							"    console.log(\"Saved JWT Token: \" + jsonData.data.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			]
		},
