				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"System Administrator\",\n  \"email\": \"admin@bugflow.com\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\"\n}"
				},
				"url": {
					"raw": "http://127.0.0.1:8000/api/auth/register",
